## Preferences

deepread-pref-show =
    .label = 显示
deepread-pref-hide =
    .label = 隐藏
deepread-pref-test =
    .label = 测试连接

deepread-pref-llm-preset = 服务预设
deepread-pref-llm-preset-custom =
    .label = 自定义
deepread-pref-llm-preset-hint = 选择预设会自动填入接口地址和模型名，随后请填写 API Key。支持任何 OpenAI 兼容接口。
deepread-pref-llm-baseurl = 接口地址
deepread-pref-llm-apikey = API Key
deepread-pref-llm-model = 模型
deepread-pref-llm-chatmodel = 对话模型
deepread-pref-llm-chatmodel-input =
    .placeholder = 留空则同上
deepread-pref-llm-jsonmode = JSON 模式
deepread-pref-llm-jsonmode-object =
    .label = json_object（兼容性最好）
deepread-pref-llm-jsonmode-schema =
    .label = json_schema（严格结构，需服务支持）
deepread-pref-llm-jsonmode-none =
    .label = none（不发送 response_format）
deepread-pref-llm-temperature = 温度
deepread-pref-llm-concurrency = 并发数 (1–64)
deepread-pref-llm-extraheaders = 额外请求头 (JSON，可选)

deepread-pref-parser-provider = 解析服务
deepread-pref-parser-provider-builtin =
    .label = 内置解析（PDF 文本层，无需服务，推荐）
deepread-pref-parser-provider-grobid =
    .label = GROBID 本地服务（轻量，CPU）
deepread-pref-parser-provider-mineru =
    .label = MinerU 官方 API
deepread-pref-parser-provider-selfhost =
    .label = 自建 / 第三方 MinerU 兼容服务
deepread-pref-parser-builtin-hint = 直接使用 PDF 自带的文字层识别段落、标题、图表和公式，速度快、免费、不上传文件。适合大多数电子版论文；扫描版 PDF 没有文字层，无法使用精读功能。复杂表格和公式较多时可改用 GROBID 或 MinerU。
deepread-pref-parser-grobid-hint = GROBID 是专为学术论文设计的开源解析服务，仅需 CPU 和约 1–2 GB 内存。用 Docker 启动：在插件源码目录运行 scripts/grobid.sh start。
deepread-pref-parser-grobid-url = 服务地址
deepread-pref-parser-mineru-hint = 请在 https://mineru.net/apiManage 申请 Token。
deepread-pref-parser-token = Token
deepread-pref-parser-mineru-model = 解析模型
deepread-pref-parser-mineru-language = 文档语言
deepread-pref-parser-mineru-ocr =
    .label = 启用 OCR
deepread-pref-parser-mineru-formula =
    .label = 识别公式
deepread-pref-parser-mineru-table =
    .label = 识别表格
deepread-pref-parser-selfhost-hint = 填写 mineru-api 或兼容服务的地址（POST 地址/file_parse）。
deepread-pref-parser-selfhost-url = 服务地址
deepread-pref-parser-selfhost-token = Token（可选）
deepread-pref-parser-selfhost-backend = 后端

deepread-pref-language = 输出语言
deepread-pref-filter-author =
    .label = 过滤作者/单位信息块
deepread-pref-view-highlights =
    .label = 在 PDF 中显示高亮
deepread-pref-view-hovercards =
    .label = 悬停显示要点卡片
deepread-pref-view-translation =
    .label = 悬停段落时原位显示译文（按住 Alt 看原文）
deepread-pref-card-width = 卡片宽度
deepread-pref-card-fontsize = 卡片字号
deepread-pref-card-size-hint = 也可以拖动卡片栏靠近 PDF 的边缘调整宽度
deepread-pref-card-layout = 卡片位置
deepread-pref-card-layout-split =
    .label = 自动：单栏论文放一侧，双栏论文放两侧
deepread-pref-card-layout-right =
    .label = 全部放在右侧
deepread-pref-cards-autoexplain =
    .label = 精读后自动生成每段的 AI 讲解
deepread-pref-cards-autoexplain-hint = 页边卡片以 AI 讲解为主体，译文默认折叠；关闭后可在卡片上手动生成
deepread-pref-cards-translationopen =
    .label = 卡片中的译文默认展开
deepread-pref-chat-maxcontext = 对话最大上下文字符数

deepread-pref-privacy-title = 隐私
deepread-pref-privacy-note = API Key 保存在本机的 Zotero 设置中；PDF 内容只会发送到您在此处配置的服务。

deepread-pref-update-title = 版本与更新
deepread-pref-update-current =
    .value = 当前版本
deepread-pref-update-check =
    .label = 检查更新
deepread-pref-update-hint = 插件每天会自动检查一次更新。
deepread-pref-update-releases = 查看更新日志

# --- v0.8 settings pane ---
deepread-pref-llm-title = ① 精读 API
deepread-pref-llm-hint = 用于翻译、卡片讲解、AI 对话。可保存多套服务，点选卡片即可一键切换。
deepread-pref-profile-add =
    .label = + 添加
deepread-pref-profile-copy =
    .label = 复制
deepread-pref-profile-delete =
    .label = 删除
deepread-pref-profile-name = 配置名称
deepread-pref-current = 当前
deepread-pref-parser-title = ② 文档解析
deepread-pref-parser-hint = 决定如何把 PDF 切成段落、标题、图表和公式。外部服务（MinerU、GROBID）失败时，会自动改用内置文字层。
deepread-pref-card-parser-mineru-title = MinerU 官方 API
deepread-pref-card-parser-mineru-desc = 云端解析，版面、公式、表格最准；需要 Token，PDF 会上传到 mineru.net
deepread-pref-card-parser-selfhost-title = 自建 MinerU
deepread-pref-card-parser-selfhost-desc = 你自己部署的 MinerU 或兼容服务，PDF 只发往你的服务器
deepread-pref-card-parser-builtin-title = 内置文字层（离线、免费）
deepread-pref-card-parser-builtin-desc = 直接读取 PDF 文字层，不上传文件；扫描版 PDF 无法使用
deepread-pref-card-parser-grobid-title = GROBID 本地
deepread-pref-card-parser-grobid-desc = 本机 Docker 运行的学术论文解析服务，仅需 CPU
deepread-pref-agent-title = ③ Agent
deepread-pref-agent-hint = 供后续的「带读」模块使用。带读将在 v1.0 推出，这些设置现在就可以先准备好。
deepread-pref-card-agent-none-title = 不使用
deepread-pref-card-agent-none-desc = 暂不启用 Agent
deepread-pref-card-agent-codex-title = 本地 Codex
deepread-pref-card-agent-codex-desc = 调用本机的 Codex 命令行
deepread-pref-card-agent-claude-title = 本地 Claude Code
deepread-pref-card-agent-claude-desc = 调用本机的 Claude Code 命令行
deepread-pref-card-agent-api-title = 远程 API
deepread-pref-card-agent-api-desc = Anthropic 或 OpenAI 兼容接口
deepread-pref-card-agent-import-title = 只导入结果文件
deepread-pref-card-agent-import-desc = 在别处生成，把结果文件导入 Zotero
deepread-pref-agent-command = 启动命令
deepread-pref-agent-skills = 技能
deepread-pref-agent-timeout = 超时（分钟）
deepread-pref-agent-api-baseurl = 接口地址
deepread-pref-agent-api-apikey = API Key
deepread-pref-agent-api-model = 模型
deepread-pref-agent-import-hint = 带读推出后，可导入 Agent 在别处生成的结果文件，无需在此配置。
deepread-pref-agent-detect =
    .label = 检测
deepread-pref-modules-title = 功能模块
deepread-pref-modules-hint = 这里是所有文献的默认值；阅读时可在工具栏「功能」里按文献勾选。
deepread-pref-mod-margincards =
    .label = 页边卡片
deepread-pref-mod-margincards-hint = 单栏一侧、双栏两侧，自动判断
deepread-pref-mod-structurebar =
    .label = 全文结构条
deepread-pref-mod-figurecards =
    .label = 图表卡片
deepread-pref-mod-skim =
    .label = 速读分层
deepread-pref-mod-skim-hint = 速读分层：工具栏下可选阅读深度（全文 / 重点 / 只看边注），淡化次要段落、标出关键句，次要卡片收成一行
deepread-pref-mod-lookup =
    .label = 悬停查证
deepread-pref-mod-lookup-hint = 悬停查证：鼠标停在引用和图表引用上显示说明，与卡片相互独立
deepread-pref-mod-questions =
    .label = 问题导向
deepread-pref-mod-questions-hint = 问题导向：精读后给出 5 个阅读问题，可加自己的问题；答案挂到卡片和结构条
deepread-pref-mod-guided =
    .label = 带读
deepread-pref-mod-guided-hint = 带读：用 ③ Agent 通道（本地 Codex / Claude Code、远程 API 或导入结果）生成精读长文和精读卡，整理成 定位 → 骨架 → 方法 → 证据 → 带走 五步，并同步到页边卡片
deepread-pref-reading-title = 阅读
deepread-pref-privacy-agent = 本地 Agent 使用它自己的模型和账号；PDF 只在本机交给 Agent。
deepread-pref-agent-found = 已检测到 { $kind } · { $n } 个技能可用
deepread-pref-agent-notfound = 未在 PATH 中找到 { $kind } · { $n } 个技能可用
deepread-pref-agent-skills-missing = 缺少技能：{ $names }
deepread-pref-cards-keepopen =
    .label = 卡片保持展开（点击别处不会收起）
deepread-pref-cards-groupparagraphs =
    .label = 相关段落合并为一张卡片
deepread-pref-cards-groupparagraphs-hint = 下次生成 AI 讲解时生效（AI 会判断哪些相邻段落在讲同一件事）
deepread-pref-hl-title = 荧光笔颜色
deepread-pref-hl-add =
    .label = +
deepread-pref-hl-remove =
    .label = −
deepread-pref-hl-reset =
    .label = 恢复默认
deepread-pref-hl-hint = 点击卡片上的要点会依次换成这些颜色，最后一次清除
